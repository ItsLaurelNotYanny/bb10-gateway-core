# Per-app variables (placeholders only; copy to private/apps/<app>.env)
COMPOSE_PROJECT_NAME=<app>
PRESET=example
PORT=3443
PROFILE_VOLUME=<app>-profile
# true for an existing production volume, false to let compose create it
PROFILE_EXTERNAL=false
CERTS_DIR=<CERTS_DIR>
TOKEN_FILE=<TOKEN_FILE>
PRESETS_DIR=<PRESETS_DIR>
UPSTREAM_HOST=<UPSTREAM_HOST>
# PROFILE_TARGET_PATH=/data/profile
# IMAGE=bb10-gateway-core:latest
# MEM_LIMIT=1g
# TZ=UTC
# Runtime overrides (leave unset to keep preset values)
# TARGET_URL=
# WIN_W=
# WIN_H=
# JPEG_QUALITY=
# ICON_STYLE=
